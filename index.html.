<!DOCTYPE html>
<html lang="fr"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Salle d'arcade IA</title>
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@500;800&display=swap" rel="stylesheet">
<style>
:root{--bg:#eaf4f6;--panel:#fff;--ink:#0d2733;--mute:#4b6f7a;--water:#1a9db8;--gold:#b98a10;--line:#c5dde3;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#0d2733;--panel:#123645;--ink:#eaf6f8;--mute:#8fb3bd;--water:#3fd0e8;--gold:#e3b341;--line:#22516a}}
:root[data-theme="dark"]{--bg:#0d2733;--panel:#123645;--ink:#eaf6f8;--mute:#8fb3bd;--water:#3fd0e8;--gold:#e3b341;--line:#22516a}
*,*::before,*::after{box-sizing:inherit}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
body{margin:0;background:var(--bg);color:var(--ink);font-family:"Bricolage Grotesque",system-ui,sans-serif;line-height:1.5}
main{max-width:860px;margin:0 auto;padding:24px 16px 40px}
h1{font-size:clamp(2rem,6vw,3.2rem);font-weight:800;margin:0 0 4px;letter-spacing:-.02em}
p.sub{margin:0 0 24px;color:var(--mute)}
.wrap{display:flex;gap:24px;flex-wrap:wrap;align-items:flex-start}
.stage{flex:1 1 360px;max-width:400px}
canvas{display:block;width:auto;max-width:100%;height:auto;max-height:66svh;margin:0 auto;border-radius:12px;border:2px solid var(--line);background:#0d2733;touch-action:none;cursor:pointer;user-select:none;-webkit-user-select:none;-webkit-touch-callout:none;-webkit-tap-highlight-color:transparent}
.side{flex:1 1 240px}
.tabs{display:grid;grid-template-columns:repeat(2,1fr);gap:8px;margin-bottom:16px}
.tab{padding:12px 14px;border:1px solid var(--line);border-radius:8px;background:var(--panel);color:var(--ink);font:inherit;text-align:left}
.tab[aria-current="true"]{border:2px solid var(--water)}
.tab:disabled{color:var(--mute);opacity:.7}
.pick{display:flex;gap:8px;margin:8px 0 16px}
.pick button{flex:1;padding:10px;border-radius:8px;border:1px solid var(--line);background:var(--panel);color:var(--ink);font:inherit;font-weight:500;cursor:pointer}
.pick button[aria-pressed="true"]{background:var(--water);color:#06202a;border-color:var(--water)}
button:focus-visible,canvas:focus-visible{outline:3px solid var(--gold);outline-offset:2px}
small{color:var(--mute)}
[hidden]{display:none!important}
.hud{display:flex;gap:16px;justify-content:space-between;flex-wrap:wrap;margin-bottom:8px}
blockquote{margin:0 0 12px;padding:16px;border-left:4px solid var(--water);background:var(--panel);border-radius:8px;min-height:130px}
input{width:100%;padding:12px;margin-top:8px;border-radius:8px;border:1px solid var(--line);background:var(--panel);color:var(--ink);font:inherit}
progress{width:110px;vertical-align:middle;accent-color:var(--water)}
.tab{cursor:pointer}
body{overscroll-behavior-y:contain}
button{touch-action:manipulation}
.tab{text-align:center;min-height:44px}
#pr{touch-action:pan-y}
.pick button{min-height:48px}
.row{display:flex;gap:8px;margin:8px 0}
.row input{flex:1;margin:0;font-size:16px}
.row button{padding:0 16px;border-radius:8px;border:1px solid var(--line);background:var(--panel);color:var(--ink);font:inherit;font-weight:500;min-height:48px}
.dpad{display:none;grid-template-columns:repeat(3,64px);gap:8px;justify-content:center;margin-top:12px}
.dpad button{height:56px;border-radius:8px;border:1px solid var(--line);background:var(--panel);color:var(--ink);font-size:20px}
.dpad button:nth-child(1){grid-area:1/2}.dpad button:nth-child(2){grid-area:2/1}.dpad button:nth-child(3){grid-area:2/2}.dpad button:nth-child(4){grid-area:2/3}
@media (pointer:coarse){.dpad{display:grid}}
@media (max-width:600px){h1{font-size:1.6rem}main{padding:12px 12px 24px}.wrap{gap:12px}}
#pr{max-height:none;width:100%;max-width:360px}
.rule{margin:0 0 16px;padding:10px 12px;border-left:4px solid var(--water);background:var(--panel);border-radius:8px}
body{padding-right:32px}
#sb{position:fixed;right:0;top:env(safe-area-inset-top,0px);bottom:env(safe-area-inset-bottom,0px);width:30px;display:flex;flex-direction:column;background:var(--panel);border-left:1px solid var(--line);z-index:9}
#sb button{height:36px;border:0;background:none;color:var(--mute);font-size:14px}
#sb-t{flex:1;position:relative;margin:2px 6px}
#sb-h{position:absolute;left:0;right:0;top:0;height:40px;border-radius:8px;background:var(--mute);opacity:.7;touch-action:none}
@media (pointer:fine){#sb{display:none}body{padding-right:0}}
.tip{margin:0 0 8px;padding:8px 10px;border-radius:8px;background:var(--panel);border:1px dashed var(--gold)}
#p-prompt.fs{position:fixed;left:0;right:0;top:0;height:100%;z-index:20;background:var(--bg);padding:6px 8px;display:flex;flex-direction:column;overflow:hidden}
#p-prompt.fs .tip{display:none}
#p-prompt.fs .pick button,#p-prompt.fs .row button{min-height:40px}
#p-prompt.fs .hud{margin-bottom:4px}
#p-prompt.fs .row{margin:6px 0 0}
#p-prompt.fs #pr{margin-bottom:0}
#p-prompt.fs.playing #lv-pick{display:none}
#p-prompt.fs #pr{flex:1;min-height:0;width:100%;max-width:none;height:100%;object-fit:contain}
#p-prompt.fs .ptop{display:flex;align-items:center;gap:8px;margin-bottom:6px}
#p-prompt.fs .ptop .pick{margin:0;flex:0 0 auto}
#p-prompt.fs .ptop .pick button{min-height:36px;padding:0 12px;font-size:14px}
#p-prompt.fs .ptop .hud{flex:1;margin:0;flex-wrap:nowrap;gap:6px;font-size:14px}
#p-prompt.fs #lv-pick{margin:0 0 6px}
#p-prompt.fs #lv-pick button{min-height:36px}
#p-prompt.fs #pr{object-fit:fill}
#p-prompt.fs.playing .ptop{display:none}
#pfs2{display:none}
#p-prompt.fs #pfs2{display:inline-block;padding:0 14px}
</style></head>
<body><main>
<h1>Salle d'arcade IA</h1>
<p class="sub">4 mini-jeux sur le thème de l'intelligence artificielle, à jouer sur téléphone ou ordinateur. Choisis un jeu avec les onglets : une courte explication s'affiche pour chacun. Le but : battre ton record et celui de tes potes !</p>
<div class="tabs">
   <button class="tab" data-g="flappy" aria-current="true">Surchauffe</button>
   <button class="tab" data-g="turing" aria-current="false">Turing Test</button>
   <button class="tab" data-g="snake" aria-current="false">Neural Snake</button>
   <button class="tab" data-g="prompt" aria-current="false">Prompt Rapide</button>
  </div>
<p class="rule" id="rule"></p>
<div class="wrap">
 <div class="stage"><canvas id="g" width="360" height="540" tabindex="0" aria-label="Jeu : le composant évite les jets d'eau"></canvas>

 <div id="p-turing" hidden>
  <div class="hud"><span>Score <b id="tu-s">0</b></span><span>Série <b id="tu-st">0</b></span><span>Temps <b id="tu-t">15</b></span></div>
  <blockquote id="tu-q"></blockquote>
  <div class="pick" id="tu-ans" hidden><button id="tu-h">Humain</button><button id="tu-a">IA</button></div>
  <div class="pick" id="tu-start"><button id="tu-go">Démarrer</button></div>
  <p id="tu-f" aria-live="polite"></p>
 </div>
 <div id="p-snake" hidden>
  <div class="hud"><span>Neurones <b id="sn-s">0</b></span><label>IA <progress id="sp" max="100" value="0"></progress> <b id="spp">0 %</b></label></div>
  <canvas id="sn" width="360" height="360" tabindex="0" aria-label="Neural Snake"></canvas>
  <div class="dpad"><button data-d="0,-1" aria-label="Haut">▲</button><button data-d="-1,0" aria-label="Gauche">◀</button><button data-d="0,1" aria-label="Bas">▼</button><button data-d="1,0" aria-label="Droite">▶</button></div>
  <p>Glisse le doigt sur le jeu, utilise les boutons, ou les flèches / ZQSD.</p>
 </div>
 <div id="p-prompt" hidden>
  <p class="tip">👉 Passe d'abord en plein écran, sinon le clavier cache les mots qui tombent.</p>
  <div class="ptop"><div class="pick"><button id="pfs">⛶ Passer en plein écran</button></div><div class="hud"><span>Score <b id="ps">0</b></span><span>Vies <b id="pl">3</b></span><span>Record <b id="pb">0</b></span></div></div>
  <div class="pick" id="lv-pick"><button data-lv="facile" aria-pressed="false">Facile</button><button data-lv="moyen" aria-pressed="true">Moyen</button><button data-lv="difficile" aria-pressed="false">Difficile</button></div>
  <canvas id="pr" width="360" height="320" aria-label="Le Prompt Rapide"></canvas>
  <div class="row"><input id="pi" autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false" enterkeyhint="go" placeholder="Tape le mot ici"><button id="pgo">Démarrer</button><button id="pfs2" aria-label="Quitter le plein écran">✕</button></div>
 </div></div>
 <div class="side">
  <div id="o-flappy"><p style="margin:0">Choisis ton composant :</p>
  <div class="pick"><button id="bCPU" aria-pressed="true">Processeur</button><button id="bRAM" aria-pressed="false">RAM</button></div>
  <p style="margin:0 0 4px">Clique, touche l'écran ou appuie sur Espace pour faire monter le composant. Passe entre les jets d'eau.</p>
  <small>Meilleur score : <b id="best">0</b></small></div>
 </div>
</div>
</main>
<div id="sb" aria-hidden="true"><button id="sb-u" tabindex="-1">▲</button><div id="sb-t"><div id="sb-h"></div></div><button id="sb-d" tabindex="-1">▼</button></div>
<script>
const c=document.getElementById('g'),x=c.getContext('2d'),W=360,H=540;
const G=.3,J=-5.4,SP=2.2,GAP=200,PW=54,S=30,BX=90;
let mode='CPU',state,y,v,pipes,score,t,best=0;
try{best=+localStorage.getItem('flappyIA')||0}catch(e){}
document.getElementById('best').textContent=best;
function reset(){y=H/2;v=0;pipes=[];score=0;t=0;state='ready'}
function flap(){if(state==='over'){reset();return}if(state==='ready')state='play';v=J}
c.addEventListener('pointerdown',e=>{e.preventDefault();flap()});
addEventListener('keydown',e=>{if(cur==='flappy'&&(e.code==='Space'||e.code==='ArrowUp')){e.preventDefault();flap()}});
function setMode(m){mode=m;bCPU.setAttribute('aria-pressed',m==='CPU');bRAM.setAttribute('aria-pressed',m==='RAM')}
bCPU.onclick=()=>setMode('CPU');bRAM.onclick=()=>setMode('RAM');
function jet(px,y0,y1){
 const g=x.createLinearGradient(px,0,px+PW,0);
 g.addColorStop(0,'#1a9db8');g.addColorStop(.5,'#8ff0ff');g.addColorStop(1,'#1a9db8');
 x.fillStyle=g;x.fillRect(px,y0,PW,y1-y0);
 x.strokeStyle='rgba(255,255,255,.45)';x.lineWidth=2;
 for(let i=0;i<3;i++){const lx=px+10+i*17;x.beginPath();
  for(let yy=y0;yy<y1;yy+=6){x.lineTo(lx+Math.sin((yy+t*3)/9)*3,yy)}x.stroke()}
}
function chip(){
 x.save();x.translate(BX,y);x.rotate(Math.max(-.4,Math.min(.5,v/16)));
 x.fillStyle='#e3b341';
 for(let i=0;i<4;i++){x.fillRect(-4,4+i*7,5,3);x.fillRect(S-1,4+i*7,5,3)}
 x.fillStyle='#1f7a63';x.fillRect(0,0,S,S);
 x.strokeStyle='#e3b341';x.lineWidth=2;x.strokeRect(1,1,S-2,S-2);
 x.fillStyle='#eaf6f8';x.font='700 10px sans-serif';x.textAlign='center';x.fillText(mode,S/2,S/2+4);
 x.restore();
}
function over(){state='over';if(score>best){best=score;document.getElementById('best').textContent=best;try{localStorage.setItem('flappyIA',best)}catch(e){}}}
function text(s,yy,size){x.fillStyle='#eaf6f8';x.textAlign='center';x.font='800 '+size+'px "Bricolage Grotesque",sans-serif';x.fillText(s,W/2,yy)}
function loop(){
 if(state==='play'){
  v+=G;y+=v;t++;
  if(t%100===1)pipes.push({x:W,gy:70+Math.random()*(H-GAP-140),d:false});
  for(const p of pipes){p.x-=SP;
   if(!p.d&&p.x+PW<BX){p.d=true;score++}
   if(BX+S-3>p.x&&BX+3<p.x+PW&&(y+3<p.gy||y+S-3>p.gy+GAP))over()}
  pipes=pipes.filter(p=>p.x>-PW);
  if(y<0||y+S>H)over();
 } else if(state==='ready'){t++;y=H/2+Math.sin(t/12)*8}
 x.fillStyle='#0d2733';x.fillRect(0,0,W,H);
 x.strokeStyle='#123f52';x.lineWidth=1;
 for(let i=0;i<W;i+=30){x.beginPath();x.moveTo(i,0);x.lineTo(i,H);x.stroke()}
 for(const p of pipes){jet(p.x,0,p.gy);jet(p.x,p.gy+GAP,H)}
 chip();
 text(String(score),56,40);
 if(state==='ready'){text('Touche pour démarrer',H-70,22)}
 if(state==='over'){x.fillStyle='rgba(13,39,51,.75)';x.fillRect(0,H/2-70,W,140);text('Court-circuit !',H/2-15,34);text('Score '+score+' · touche pour rejouer',H/2+25,18)}
 requestAnimationFrame(loop)
}
reset();loop();
const $=i=>document.getElementById(i);var cur='flappy';
function go(k){pfs(false);cur=k;clearInterval(Tint);clearTimeout(Stm);
 $('g').hidden=$('o-flappy').hidden=k!=='flappy';
 for(const n of['turing','snake','prompt'])$('p-'+n).hidden=k!==n;
 document.querySelectorAll('.tab').forEach(b=>b.setAttribute('aria-current',b.dataset.g===k));
 $('rule').textContent=RULES[k];reset();if(k==='turing'){Ts=Tst=0;Tt=15;Tidle("Prêt ? Lis la règle au-dessus, puis appuie sur Démarrer : le chrono ne commence qu'à ce moment-là.")}if(k==='snake')Sreset();if(k==='prompt')setLevel(Plv)}
document.querySelectorAll('.tab').forEach(b=>b.onclick=()=>go(b.dataset.g));
const RULES={
flappy:"Tu es un composant d'ordinateur (processeur ou RAM). Touche l'écran (ou Espace) pour monter, et passe entre les jets d'eau sans les toucher. Chaque jet passé = 1 point.",
turing:"Lis le texte et devine s'il a été écrit par un humain ou par une IA. Tu as 15 secondes par texte, 10 textes en tout. Les bonnes réponses à la suite donnent un bonus de série.",
snake:"Tu es un paquet de données. Mange les neurones bleus pour entraîner l'IA : la barre monte et le serpent accélère doucement. Ne touche ni les murs ni ta queue.",
prompt:"Des mots liés à l'IA tombent. Tape-les en entier avant qu'ils touchent la ligne rouge : chaque mot raté = une vie perdue. Choisis ton niveau (facile, moyen, difficile) et passe en plein écran AVANT de lancer la partie pour bien voir les mots."};
$('rule').textContent=RULES.flappy;

/* Jeu 2 : Turing Test (modifie la liste Q pour ajouter tes textes) */
const Q=[
{t:"Le changement climatique représente un défi majeur : il est essentiel d'agir collectivement, au niveau individuel comme institutionnel, pour préserver notre planète.",ai:true},
{t:"Il y a plusieurs raisons pour lesquelles le sommeil est important : il améliore la concentration, renforce la mémoire et contribue à la santé globale.",ai:true},
{t:"Bien sûr ! Voici quelques conseils pour réviser efficacement : planifie tes sessions, fais des pauses régulières et teste-toi avec des exercices.",ai:true},
{t:"La photosynthèse est un processus fascinant par lequel les plantes transforment la lumière du soleil en énergie chimique, jouant un rôle crucial dans l'écosystème.",ai:true},
{t:"En conclusion, les réseaux sociaux offrent à la fois des opportunités et des risques, et leur impact dépend de la manière dont ils sont utilisés.",ai:true},
{t:"Chaque journée est une nouvelle occasion de grandir, d'apprendre et de se rapprocher de ses objectifs, un pas après l'autre.",ai:true},
{t:"franchement le prof de maths a rendu les copies et j'ai eu 9, je m'y attendais pas du tout, je crois j'ai mal lu la consigne lol",ai:false},
{t:"Hier on est allés à la plage et j'ai oublié la crème solaire. Résultat : je ressemble à une écrevisse et ma mère se moque de moi depuis ce matin.",ai:false},
{t:"Ma grand-mère fait un gâteau au yaourt toujours un peu cramé sur les bords mais c'est le meilleur du monde, et on lui dit jamais assez.",ai:false},
{t:"j'sais pas pourquoi mais le wifi du lycée plante tout le temps pile quand faut rendre un truc, c'est un complot je te jure",ai:false},
{t:"Bon, j'ai relu trois fois le chapitre sur la Guerre froide et je comprends toujours pas la différence entre détente et coexistence pacifique…",ai:false},
{t:"Mon chat a renversé mon verre sur le clavier ce matin. Le clavier marche encore mais la touche E colle. Donc voilà, écrire est devenu pénible.",ai:false}];
let Tq,Ti,Ts,Tst,Tt=15,Tint,Tend,Tlock;
function Tidle(msg){clearInterval(Tint);Tlock=false;Thud();$('tu-f').textContent='';$('tu-q').textContent=msg;$('tu-ans').hidden=true;$('tu-start').hidden=false;$('tu-go').textContent='Démarrer'}
function Tstart(){Tq=[...Q].sort(()=>Math.random()-.5).slice(0,10);Ti=Ts=Tst=0;Tend=false;$('tu-ans').hidden=false;$('tu-start').hidden=true;Tnext()}
function Thud(){$('tu-s').textContent=Ts;$('tu-st').textContent=Tst;$('tu-t').textContent=Tt}
function Tnext(){if(cur!=='turing')return;Tlock=false;$('tu-f').textContent='';clearInterval(Tint);
 if(Ti>=Tq.length){Tend=true;Tidle('Terminé ! Score final : '+Ts+'.');$('tu-go').textContent='Rejouer';return}
 $('tu-q').textContent=Tq[Ti].t;Tt=15;Thud();
 Tint=setInterval(()=>{Tt--;Thud();if(Tt<=0)Tans(null)},1000)}
function Tans(a){if(Tlock)return;if(Tend){Tstart();return}
 clearInterval(Tint);Tlock=true;const q=Tq[Ti],ok=a===q.ai;
 if(ok){Tst++;Ts+=10+Math.min(Tst,5)*2+Tt}else Tst=0;Thud();
 $('tu-f').textContent=(a===null?'Temps écoulé. ':ok?'Bien vu ! ':'Raté. ')+"C'était "+(q.ai?'une IA':'un humain')+'.';
 Ti++;setTimeout(Tnext,1500)}
$('tu-go').onclick=Tstart;$('tu-h').onclick=()=>Tans(false);$('tu-a').onclick=()=>Tans(true);

/* Jeu 3 : Neural Snake */
const sx=$('sn').getContext('2d'),SN=18,SC=20;let Sb,Sd,Sq,Sf,Se,Ss,Stm;
function Sreset(){clearTimeout(Stm);Sb=[{x:9,y:9},{x:8,y:9},{x:7,y:9}];Sd=Sq={x:1,y:0};Se=0;Ss='ready';Sfood();Shud();Sdraw()}
function Sfood(){do{Sf={x:Math.random()*SN|0,y:Math.random()*SN|0}}while(Sb.some(s=>s.x===Sf.x&&s.y===Sf.y))}
function Shud(){const p=Math.min(100,Se*8);$('sn-s').textContent=Se;$('sp').value=p;$('spp').textContent=p+' %'}
function Sstep(){Sd=Sq;const h={x:Sb[0].x+Sd.x,y:Sb[0].y+Sd.y};
 if(h.x<0||h.y<0||h.x>=SN||h.y>=SN||Sb.some(s=>s.x===h.x&&s.y===h.y)){Ss='dead';Sdraw();return}
 Sb.unshift(h);if(h.x===Sf.x&&h.y===Sf.y){Se++;Sfood();Shud()}else Sb.pop();
 Sdraw();Stm=setTimeout(Sstep,Math.max(90,260-Se*8))}
function Sdraw(){const w=SN*SC;sx.fillStyle='#0d2733';sx.fillRect(0,0,w,w);
 sx.fillStyle='#3fd0e8';sx.beginPath();sx.arc(Sf.x*SC+10,Sf.y*SC+10,7,0,7);sx.fill();
 Sb.forEach((s,i)=>{sx.fillStyle=i?'#1f7a63':'#e3b341';sx.fillRect(s.x*SC+1,s.y*SC+1,SC-2,SC-2)});
 sx.fillStyle='#eaf6f8';sx.textAlign='center';
 if(Ss!=='play'){sx.font='800 26px "Bricolage Grotesque",sans-serif';sx.fillText(Ss==='dead'?'Données perdues':'Neural Snake',w/2,w/2-8);
  sx.font='500 16px "Bricolage Grotesque",sans-serif';sx.fillText('Appuie sur une flèche'+(Ss==='dead'?' pour rejouer':''),w/2,w/2+20)}}
function Sin(dx,dy){if(cur!=='snake')return;if(Ss==='dead')Sreset();if(dx===-Sd.x&&dy===-Sd.y)return;Sq={x:dx,y:dy};if(Ss==='ready'){Ss='play';Sstep()}}
const K={arrowup:[0,-1],w:[0,-1],z:[0,-1],arrowdown:[0,1],s:[0,1],arrowleft:[-1,0],a:[-1,0],q:[-1,0],arrowright:[1,0],d:[1,0]};
addEventListener('keydown',e=>{const d=K[e.key.toLowerCase()];if(cur==='snake'&&d){e.preventDefault();Sin(...d)}});
let sw;$('sn').style.touchAction='none';
$('sn').addEventListener('pointerdown',e=>sw=[e.clientX,e.clientY]);
$('sn').addEventListener('pointerup',e=>{if(!sw)return;const dx=e.clientX-sw[0],dy=e.clientY-sw[1];if(Math.max(Math.abs(dx),Math.abs(dy))<20)return;Math.abs(dx)>Math.abs(dy)?Sin(Math.sign(dx),0):Sin(0,Math.sign(dy))});

/* Jeu 4 : Le Prompt Rapide */
const pcx=$('pr').getContext('2d'),PWORDS=["algorithme","GPU","réseau de neurones","prompt","token","modèle","données","apprentissage","biais","transformer","tenseur","inférence","LLM","gradient","paramètres","dataset","robot","pixel","rétropropagation","hallucination","surapprentissage","classification"];
let Pw=[],Ps=0,Pl=3,Pon=false,Pt=0,Pbest=0,Plv="moyen";
const LV={facile:{l:5,i:160,m:55,s:.4,g:150,w:w=>w.length<=8},moyen:{l:3,i:140,m:40,s:.55,g:110,w:w=>w.length<=12},difficile:{l:2,i:110,m:28,s:.8,g:80,w:w=>w.length>=9}};
function setLevel(k){Plv=k;Pon=false;Pw=[];Pl=LV[k].l;Ps=0;$('pl').textContent=Pl;$('ps').textContent=0;
 document.querySelectorAll('[data-lv]').forEach(b=>b.setAttribute('aria-pressed',b.dataset.lv===k));
 try{Pbest=+localStorage.getItem('promptIA-'+k)||0}catch(e){Pbest=0}$('pb').textContent=Pbest}
document.querySelectorAll('[data-lv]').forEach(b=>b.onclick=()=>setLevel(b.dataset.lv));setLevel(Plv);
const norm=s=>s.normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase().trim();
function Pstart(){Pw=[];Ps=0;Pl=LV[Plv].l;Pt=0;Pon=true;$('ps').textContent=0;$('pl').textContent=Pl;$('pi').value='';$('pi').focus()}
function Ploop(){
 if(cur==='prompt'){pp.classList.toggle('playing',Pon);Pfit();
  const W=PC.width/PD,H=PC.height/PD,Hl=H-30,hud=pp.classList.contains('fs')&&Pon,T=hud?46:22;
  pcx.font='700 20px "Bricolage Grotesque",sans-serif';
  if(Pon){Pt++;
   if(Pt%Math.max(LV[Plv].m,LV[Plv].i-Ps)===1){const pool=PWORDS.filter(LV[Plv].w),w=pool[Math.random()*pool.length|0];Pw.push({w,m:pcx.measureText(w).width+20,xf:Math.random(),yf:0})}
   const sp=Math.min(4,LV[Plv].s+Ps/LV[Plv].g)/268;for(const o of Pw)o.yf+=sp;
   const miss=Pw.filter(o=>o.yf>=1).length;
   if(miss){Pw=Pw.filter(o=>o.yf<1);Pl-=miss;$('pl').textContent=Math.max(0,Pl);
    if(Pl<=0){Pon=false;if(Ps>Pbest){Pbest=Ps;$('pb').textContent=Ps;try{localStorage.setItem('promptIA-'+Plv,Ps)}catch(e){}}}}}
  pcx.fillStyle='#0d2733';pcx.fillRect(0,0,W,H);
  pcx.fillStyle='#ff6b6b';pcx.fillRect(0,Hl,W,2);
  if(hud){pcx.font='600 14px "Bricolage Grotesque",sans-serif';pcx.fillStyle='#8fb3bd';pcx.textAlign='left';pcx.fillText('Score '+Ps,10,22);pcx.textAlign='center';pcx.fillText('Vies '+Math.max(0,Pl),W/2,22);pcx.textAlign='right';pcx.fillText('Record '+Pbest,W-10,22);pcx.font='700 20px "Bricolage Grotesque",sans-serif'}
  const tv=norm($('pi').value);pcx.textAlign='left';
  for(const o of Pw){const x=8+o.xf*Math.max(0,W-o.m-16),y=T+o.yf*(Hl-T),hit=tv&&norm(o.w).startsWith(tv);pcx.fillStyle=hit?'#e3b341':'#123645';pcx.fillRect(x,y-21,o.m,32);pcx.fillStyle=hit?'#0d2733':'#eaf6f8';pcx.fillText(o.w,x+10,y+1)}
  if(!Pon){pcx.fillStyle='#eaf6f8';pcx.textAlign='center';pcx.font='800 26px "Bricolage Grotesque",sans-serif';pcx.fillText(Pl<=0?'Modèle planté : '+Ps:'Prêt ?',W/2,H/2-10);pcx.font='500 16px "Bricolage Grotesque",sans-serif';pcx.fillText(pp.classList.contains('fs')?'Appuie sur Démarrer':'Passe en plein écran, puis Démarrer',W/2,H/2+20)}
 }
 requestAnimationFrame(Ploop)}
$('pi').addEventListener('input',e=>{if(!Pon)return;const v=norm(e.target.value),i=Pw.findIndex(o=>norm(o.w)===v);if(i>-1){Ps+=Pw[i].w.length;Pw.splice(i,1);e.target.value='';$('ps').textContent=Ps}});
$('pi').addEventListener('keydown',e=>{if(e.key==='Enter'&&!Pon)Pstart()});
const pp=$('p-prompt'),PC=$('pr');let PD=1;
function Pfit(){let w=360,h=320,d=1;if(pp.classList.contains('fs')){const r=PC.getBoundingClientRect();w=Math.max(300,Math.round(r.width));h=Math.max(100,Math.round(r.height));d=window.devicePixelRatio||1}
 const bw=Math.round(w*d),bh=Math.round(h*d);if(PC.width!==bw||PC.height!==bh){PC.width=bw;PC.height=bh;PD=d;pcx.setTransform(d,0,0,d,0,0)}}
function fsFit(){if(pp.classList.contains('fs')){const v=window.visualViewport;pp.style.height=(v?Math.min(v.height,innerHeight):innerHeight)+'px';pp.style.top=(v?v.offsetTop:0)+'px'}else{pp.style.height='';pp.style.top=''}}
function pfs(on){pp.classList.toggle('fs',on);document.body.style.overflow=on?'hidden':'';$('pfs').textContent=on?'✕ Quitter':'⛶ Passer en plein écran';
 try{if(on){const r=(dEl.requestFullscreen||dEl.webkitRequestFullscreen).call(dEl);if(r&&r.catch)r.catch(()=>{})}else if(document.fullscreenElement)document.exitFullscreen()}catch(e){}
 fsFit()}
$('pfs').onclick=()=>pfs(!pp.classList.contains('fs'));
$('pfs2').onclick=()=>pfs(false);
if(window.visualViewport){visualViewport.addEventListener('resize',fsFit);visualViewport.addEventListener('scroll',fsFit)}
addEventListener('resize',fsFit);
document.addEventListener('fullscreenchange',()=>{if(!document.fullscreenElement&&pp.classList.contains('fs'))pfs(false)});
$('pgo').onclick=Pstart;
$('pi').addEventListener('focus',()=>{if(matchMedia('(pointer:coarse)').matches&&!pp.classList.contains('fs'))setTimeout(()=>$('p-prompt').scrollIntoView({block:'start',behavior:'smooth'}),300)});
document.querySelectorAll('[data-d]').forEach(b=>b.addEventListener('pointerdown',e=>{e.preventDefault();Sin(...b.dataset.d.split(',').map(Number))}));
Ploop();

/* Barre de défilement latérale (téléphone) */
const sb=$('sb'),sbt=$('sb-t'),sbh=$('sb-h'),dEl=document.documentElement;
function sbUpd(){const max=dEl.scrollHeight-innerHeight;sb.hidden=max<=4;if(max<=4)return;const th=sbt.clientHeight,h=Math.max(36,th*innerHeight/dEl.scrollHeight);sbh.style.height=h+'px';sbh.style.top=(th-h)*scrollY/max+'px'}
addEventListener('scroll',sbUpd,{passive:true});addEventListener('resize',sbUpd);new ResizeObserver(sbUpd).observe(document.body);sbUpd();
$('sb-u').onclick=()=>scrollBy({top:-innerHeight*.6,behavior:'smooth'});
$('sb-d').onclick=()=>scrollBy({top:innerHeight*.6,behavior:'smooth'});
let dr;sbh.addEventListener('pointerdown',e=>{dr={y:e.clientY,s:scrollY};sbh.setPointerCapture(e.pointerId)});
sbh.addEventListener('pointermove',e=>{if(!dr)return;const th=sbt.clientHeight-sbh.offsetHeight;if(th>0)scrollTo(0,dr.s+(e.clientY-dr.y)*(dEl.scrollHeight-innerHeight)/th)});
sbh.addEventListener('pointerup',()=>dr=null);
sbt.addEventListener('pointerdown',e=>{if(e.target===sbh)return;const r=sbt.getBoundingClientRect();scrollTo({top:(e.clientY-r.top)/r.height*(dEl.scrollHeight-innerHeight),behavior:'smooth'})});
</script></body></html>
